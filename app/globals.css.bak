@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --font-heading: var(--font-sans);
  --color-emerald-300: var(--emerald-300);
  --color-emerald-400: var(--emerald-400);
  --color-emerald-500: var(--emerald-500);
  --color-emerald-600: var(--emerald-600);
  --color-emerald-700: var(--emerald-700);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-muted-foreground: var(--sidebar-muted-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

:root {
  color-scheme: light;
  /* Light-first enterprise palette — source of truth: DESIGN.md §4 */
  --emerald-300: oklch(0.72 0.12 163);
  --emerald-400: oklch(0.64 0.12 163);
  --emerald-500: oklch(0.58 0.11 163);
  --emerald-600: oklch(0.52 0.10 163);
  --emerald-700: oklch(0.44 0.085 163);
  --background: oklch(0.972 0.003 250);
  --foreground: oklch(0.21 0.015 250);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.21 0.015 250);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.21 0.015 250);
  --primary: oklch(0.55 0.10 163);
  --primary-foreground: oklch(0.99 0.005 163);
  --secondary: oklch(0.955 0.004 250);
  --secondary-foreground: oklch(0.28 0.012 250);
  --muted: oklch(0.955 0.004 250);
  --muted-foreground: oklch(0.55 0.012 250);
  --accent: oklch(0.95 0.02 163);
  --accent-foreground: oklch(0.35 0.06 163);
  --destructive: oklch(0.577 0.22 27.325);
  --border: oklch(0.92 0.005 250);
  --input: oklch(0.92 0.005 250);
  --ring: oklch(0.55 0.10 163);
  --chart-1: oklch(0.37 0.02 250);
  --chart-2: oklch(0.60 0.08 163);
  --chart-3: oklch(0.72 0.10 70);
  --chart-4: oklch(0.60 0.12 27);
  --chart-5: oklch(0.62 0.01 250);
  --radius: 0.625rem;
  --sidebar: oklch(0.982 0.002 250);
  --sidebar-foreground: oklch(0.24 0.012 250);
  --sidebar-muted-foreground: oklch(0.50 0.012 250);
  --sidebar-primary: oklch(0.55 0.10 163);
  --sidebar-primary-foreground: oklch(0.99 0.005 163);
  --sidebar-accent: oklch(0.945 0.006 250);
  --sidebar-accent-foreground: oklch(0.24 0.012 250);
  --sidebar-border: oklch(0.912 0.005 250);
  --sidebar-ring: oklch(0.55 0.10 163);
}

.dark {
  color-scheme: dark;
  --emerald-300: oklch(0.82 0.11 158);
  --emerald-400: oklch(0.76 0.115 158);
  --emerald-500: oklch(0.70 0.11 158);
  --emerald-600: oklch(0.60 0.105 158);
  --emerald-700: oklch(0.50 0.09 158);
  --background: oklch(0.24 0.008 250);
  --foreground: oklch(0.93 0.005 250);
  --card: oklch(0.285 0.008 250);
  --card-foreground: oklch(0.93 0.005 250);
  --popover: oklch(0.315 0.009 250);
  --popover-foreground: oklch(0.93 0.005 250);
  --primary: oklch(0.70 0.095 158);
  --primary-foreground: oklch(0.22 0.02 158);
  --secondary: oklch(0.315 0.008 250);
  --secondary-foreground: oklch(0.92 0.005 250);
  --muted: oklch(0.305 0.007 250);
  --muted-foreground: oklch(0.73 0.007 250);
  --accent: oklch(0.35 0.02 158);
  --accent-foreground: oklch(0.95 0.004 158);
  --destructive: oklch(0.65 0.13 25);
  --border: oklch(0.86 0.006 250 / 0.16);
  --input: oklch(0.86 0.006 250 / 0.18);
  --ring: oklch(0.70 0.09 158);
  --chart-1: oklch(0.70 0.095 158);
  --chart-2: oklch(0.68 0.09 230);
  --chart-3: oklch(0.75 0.10 88);
  --chart-4: oklch(0.68 0.12 28);
  --chart-5: oklch(0.68 0.08 195);
  --sidebar: oklch(0.215 0.007 250);
  --sidebar-foreground: oklch(0.90 0.005 250);
  --sidebar-muted-foreground: oklch(0.68 0.007 250);
  --sidebar-primary: oklch(0.70 0.095 158);
  --sidebar-primary-foreground: oklch(0.22 0.02 158);
  --sidebar-accent: oklch(0.30 0.01 250);
  --sidebar-accent-foreground: oklch(0.94 0.005 250);
  --sidebar-border: oklch(0.86 0.006 250 / 0.14);
  --sidebar-ring: oklch(0.70 0.09 158);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
    scrollbar-color: color-mix(in oklch, var(--foreground) 14%, transparent) transparent;
    scrollbar-width: thin;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
}

/* ── AI Diagnosis breathing glow animation ── */
@keyframes ai-pulse {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

/* ── GMV flash on new orders ── */
@keyframes gmv-flash {
  0% { transform: scale(1); }
  50% { transform: scale(1.04); filter: brightness(1.3); }
  100% { transform: scale(1); }
}
